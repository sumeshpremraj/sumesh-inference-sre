digraph Release {
  graph [rankdir=LR, bgcolor="white", pad=0.16, nodesep=0.25, ranksep=0.35, fontname="DejaVu Sans", splines=polyline];
  node [shape=box, style="rounded,filled", color="#CBD5E1", fillcolor="#EFF6FF", fontname="DejaVu Sans", fontsize=10, margin="0.12,0.12"];
  edge [color="#64748B", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  a [label="ML team\nimage digest"];
  b [label="CI: security\ncontract + load tests"];
  c [label="GitOps deploy v2\n0% default traffic"];
  d [label="Warm up +\nexplicit-version test"];
  e [label="Progressive traffic\n1% -> 5% -> 25%\n-> 50% -> 100%", fillcolor="#DCFCE7"];
  f [label="SLO + quality\nchecks pass?", shape=diamond, fillcolor="#FEF3C7"];
  g [label="Promote v2\nretain v1 warm", fillcolor="#D1FAE5"];
  h [label="Git route change\n100% back to v1", fillcolor="#FEE2E2"];
  a -> b -> c -> d -> e -> f;
  f -> g [label="yes"];
  f -> h [label="no"];
}
